From c6951a7c8604342079418f7163461c7bd6405732 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 26 Nov 2026 13:08:09 -0500
Subject: [PATCH] Use implicit receivers in Gradle Action lambdas (kotlin-dsl
 SAM-with-receiver)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013GoRzDMz3Qj1mF3MHQzNxz
---
 .../terlingua/build/TerlinguaContentPlugin.kt | 53 +++++++++----------
 1 file changed, 26 insertions(+), 27 deletions(-)

diff --git a/build-logic/src/main/kotlin/io/github/terlingua/build/TerlinguaContentPlugin.kt b/build-logic/src/main/kotlin/io/github/terlingua/build/TerlinguaContentPlugin.kt
index 251bcfd..49f96e4 100644
--- a/build-logic/src/main/kotlin/io/github/terlingua/build/TerlinguaContentPlugin.kt
+++ b/build-logic/src/main/kotlin/io/github/terlingua/build/TerlinguaContentPlugin.kt
@@ -19,51 +19,50 @@ abstract class TerlinguaContentExtension {
     abstract val testFixtures: DirectoryProperty
 }
 
+// `kotlin-dsl` compiles Gradle `Action` lambdas with an implicit receiver (`this`), not `it`.
 class TerlinguaContentPlugin : Plugin<Project> {
     override fun apply(project: Project) {
-        val extension = project.extensions.create("terlinguaContent", TerlinguaContentExtension::class.java).apply {
-            contentDirectory.convention(project.rootProject.layout.projectDirectory.dir("content"))
-            buildDate.convention(
-                project.providers.gradleProperty("terlingua.buildDate")
-                    .orElse(project.providers.of(UtcDateValueSource::class.java) {}),
-            )
-            testFixtures.convention(project.layout.projectDirectory.dir("src/test/resources/fixtures"))
-        }
+        val extension = project.extensions.create("terlinguaContent", TerlinguaContentExtension::class.java)
+        extension.contentDirectory.convention(project.rootProject.layout.projectDirectory.dir("content"))
+        extension.buildDate.convention(
+            project.providers.gradleProperty("terlingua.buildDate")
+                .orElse(project.providers.of(UtcDateValueSource::class.java) {}),
+        )
+        extension.testFixtures.convention(project.layout.projectDirectory.dir("src/test/resources/fixtures"))
 
         project.plugins.withId("com.android.application") {
             val components = project.extensions.getByType(ApplicationAndroidComponentsExtension::class.java)
-            components.onVariants { variant ->
+            components.onVariants(components.selector().all()) { variant ->
                 val task = project.tasks.register(
                     "compile${variant.name.replaceFirstChar(Char::uppercase)}TerlinguaContent",
                     CompileContentTask::class.java,
                 ) {
-                    it.group = "terlingua"
-                    it.description = "Compiles content/ into the bundled SQLite database for ${variant.name}."
-                    it.contentDirectory.set(extension.contentDirectory)
-                    it.buildDate.set(extension.buildDate)
+                    group = "terlingua"
+                    description = "Compiles content/ into the bundled SQLite database for ${variant.name}."
+                    contentDirectory.set(extension.contentDirectory)
+                    buildDate.set(extension.buildDate)
                 }
                 variant.sources.assets?.addGeneratedSourceDirectory(task, CompileContentTask::outputDirectory)
             }
         }
 
-        val fixtures = listOf("content", "empty-content").associateWith { name ->
-            project.tasks.register("compileTerlinguaFixture${if (name == "content") "" else "Empty"}", CompileContentTask::class.java) {
-                it.group = "terlingua"
-                it.contentDirectory.set(extension.testFixtures.dir(name))
-                it.buildDate.set(FIXTURE_BUILD_DATE)
-                it.outputDirectory.set(project.layout.buildDirectory.dir("generated/terlingua/fixtures/$name"))
-            }
-        }
-        project.tasks.withType(Test::class.java).configureEach { test ->
-            test.jvmArgumentProviders.add(
-                FixtureDatabases(
-                    fixtures.getValue("content").flatMap { it.outputDirectory },
-                    fixtures.getValue("empty-content").flatMap { it.outputDirectory },
-                ),
+        val content = registerFixture(project, extension, "content", "compileTerlinguaFixture")
+        val empty = registerFixture(project, extension, "empty-content", "compileTerlinguaFixtureEmpty")
+        project.tasks.withType(Test::class.java).configureEach {
+            jvmArgumentProviders.add(
+                FixtureDatabases(content.flatMap { it.outputDirectory }, empty.flatMap { it.outputDirectory }),
             )
         }
     }
 
+    private fun registerFixture(project: Project, extension: TerlinguaContentExtension, name: String, taskName: String) =
+        project.tasks.register(taskName, CompileContentTask::class.java) {
+            group = "terlingua"
+            contentDirectory.set(extension.testFixtures.dir(name))
+            buildDate.set(FIXTURE_BUILD_DATE)
+            outputDirectory.set(project.layout.buildDirectory.dir("generated/terlingua/fixtures/$name"))
+        }
+
     internal class FixtureDatabases(
         @get:InputDirectory @get:PathSensitive(PathSensitivity.RELATIVE) val content: Provider<Directory>,
         @get:InputDirectory @get:PathSensitive(PathSensitivity.RELATIVE) val empty: Provider<Directory>,

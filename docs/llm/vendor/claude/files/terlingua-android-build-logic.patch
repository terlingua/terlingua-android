+    private val MARKUP = Regex("""<!--[\s\S]*?(?:-->|$)|<!\[CDATA\[[\s\S]*?(?:]]>|$)|</?[A-Za-z][\w:.-]*|/?>|"[^"]*"|'[^']*'|[A-Za-z_:][\w:.-]*(?==)|=""")

+                    }
+                }
+            }
+            items(chapter.sections, key = { it.key }) { ref ->
+                val isSelected = ref.key == selected
+                ListItem(
+                    headlineContent = { Text(ref.title) },
+                    supportingContent = if (ref.readingMinutes > 0) {
